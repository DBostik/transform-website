<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # SEO: consolidate the www version to non-www (fixes the homepage being split across two URLs in Google)
  RewriteCond %{HTTP_HOST} ^www\.transformpersonaltraining\.com [NC]
  RewriteRule ^(.*)$ https://transformpersonaltraining.com/$1 [R=301,L]

  # Privacy: the server holds the whole repo, but only the built site in dist/ is public.
  # Any other real file or folder (notes, drafts, source) is refused. .well-known stays
  # open for SSL certificate renewal, and Google verification files stay open.
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [F,L]

  # SEO: rescue old URLs that still rank in Google but changed slug during the migration
  RewriteRule ^healthy-restaurants-in-chicago/?$ /blog/the-top-7-healthy-restaurants-in-chicago/ [R=301,L]
  RewriteRule ^stop-the-insanity/?$ /blog/ [R=301,L]

  # Old blog posts removed in the Nov 2026 cleanup, sent to the closest kept post
  RewriteRule ^(?:blog/)?hit-your-health-goals-during-covid-19/?$ /blog/personal-training-for-busy-professionals/ [R=301,L]
  RewriteRule ^(?:blog/)?the-importance-of-me-time/?$ /blog/personal-training-for-busy-professionals/ [R=301,L]
  RewriteRule ^(?:blog/)?why-wait-until-nye/?$ /blog/what-happens-in-your-free-first-personal-training-session/ [R=301,L]
  RewriteRule ^(?:blog/)?stronger-than-your-excuses/?$ /blog/what-happens-in-your-free-first-personal-training-session/ [R=301,L]
  RewriteRule ^(?:blog/)?don-t-have-control/?$ /blog/weight-loss-plateau-3-unseen-factors/ [R=301,L]
  RewriteRule ^(?:blog/)?focus-on-yourself/?$ /blog/personal-training-for-busy-professionals/ [R=301,L]
  RewriteRule ^(?:blog/)?put-yourself-first/?$ /blog/personal-training-for-busy-professionals/ [R=301,L]
  RewriteRule ^(?:blog/)?how-to-make-a-road-bike-purchase/?$ /blog/best-low-impact-workouts-for-weight-loss/ [R=301,L]
  RewriteRule ^(?:blog/)?forgiveness-is-healthy/?$ /blog/how-long-does-it-take-to-see-results-with-a-personal-trainer/ [R=301,L]
  RewriteRule ^(?:blog/)?the-health-roller-coaster/?$ /blog/weight-loss-plateau-3-unseen-factors/ [R=301,L]
  RewriteRule ^(?:blog/)?monday-mindset/?$ /blog/how-long-does-it-take-to-see-results-with-a-personal-trainer/ [R=301,L]
  RewriteRule ^(?:blog/)?a-truth-bomb/?$ /blog/how-long-does-it-take-to-see-results-with-a-personal-trainer/ [R=301,L]
  RewriteRule ^(?:blog/)?do-the-work/?$ /blog/how-long-does-it-take-to-see-results-with-a-personal-trainer/ [R=301,L]
  RewriteRule ^(?:blog/)?draw-a-line-in-the-sand/?$ /blog/what-happens-in-your-free-first-personal-training-session/ [R=301,L]
  RewriteRule ^(?:blog/)?change-your-identity/?$ /blog/how-long-does-it-take-to-see-results-with-a-personal-trainer/ [R=301,L]
  RewriteRule ^(?:blog/)?no-better-time-than-now/?$ /blog/what-happens-in-your-free-first-personal-training-session/ [R=301,L]
  RewriteRule ^(?:blog/)?why-we-defeat-ourselves/?$ /blog/weight-loss-plateau-3-unseen-factors/ [R=301,L]
  RewriteRule ^(?:blog/)?how-to-lead-a-more-healthy-and-fit-life/?$ /blog/the-invisible-reality-internal-health/ [R=301,L]
  RewriteRule ^(?:blog/)?exercising-to-look-younger/?$ /blog/the-invisible-reality-internal-health/ [R=301,L]
  RewriteRule ^(?:blog/)?your-personal-training-studio-and-developing-a-training-plan/?$ /blog/is-personal-training-worth-it-in-chicago/ [R=301,L]
  RewriteRule ^(?:blog/)?let-me-introduce-you-to-bob/?$ /blog/how-long-does-it-take-to-see-results-with-a-personal-trainer/ [R=301,L]
  RewriteRule ^(?:blog/)?another-amazing-success-story/?$ /blog/how-long-does-it-take-to-see-results-with-a-personal-trainer/ [R=301,L]
  RewriteRule ^(?:blog/)?outdoor-chicago-adventures/?$ /blog/best-low-impact-workouts-for-weight-loss/ [R=301,L]
  RewriteRule ^(?:blog/)?workplace-workouts/?$ /blog/personal-training-for-busy-professionals/ [R=301,L]
  RewriteRule ^(?:blog/)?good-shoes/?$ /blog/best-low-impact-workouts-for-weight-loss/ [R=301,L]
  RewriteRule ^(?:blog/)?create-a-playlist-that-motivates-you/?$ /blog/best-low-impact-workouts-for-weight-loss/ [R=301,L]
  RewriteRule ^(?:blog/)?you-a-partner-great-motivation/?$ /blog/is-personal-training-worth-it-in-chicago/ [R=301,L]
  RewriteRule ^(?:blog/)?how-to-stay-fit-while-on-vacation/?$ /blog/do-online-weight-loss-coaches-work/ [R=301,L]
  RewriteRule ^(?:blog/)?healthy-shopping-at-the-chicago-sunday-farmers-market/?$ /blog/veggie-love/ [R=301,L]
  RewriteRule ^(?:blog/)?setting-fitness-goals-with-your-personal-trainer/?$ /blog/how-long-does-it-take-to-see-results-with-a-personal-trainer/ [R=301,L]
  RewriteRule ^(?:blog/)?qualities-of-a-good-fitness-trainer/?$ /blog/how-to-choose-a-personal-trainer-for-weight-loss-in-chicago/ [R=301,L]
  RewriteRule ^(?:blog/)?benefits-of-having-a-personal-trainer/?$ /blog/is-personal-training-worth-it-in-chicago/ [R=301,L]
  RewriteRule ^(?:blog/)?techniques-for-building-muscle-with-your-personal-trainer/?$ /blog/why-am-i-gaining-weight-the-guide-to-putting-on-muscle-and-how-it-helps-burn-fat/ [R=301,L]
  RewriteRule ^(?:blog/)?developing-a-strength-training-program/?$ /blog/why-am-i-gaining-weight-the-guide-to-putting-on-muscle-and-how-it-helps-burn-fat/ [R=301,L]
  RewriteRule ^(?:blog/)?ways-to-develop-a-successful-fitness-regimen/?$ /blog/how-long-does-it-take-to-see-results-with-a-personal-trainer/ [R=301,L]
  RewriteRule ^(?:blog/)?fitting-an-exercise-program-into-a-daily-routine/?$ /blog/30-minute-vs-60-minute-personal-training/ [R=301,L]
  RewriteRule ^(?:blog/)?5-tips-for-getting-fit/?$ /blog/best-low-impact-workouts-for-weight-loss/ [R=301,L]
  RewriteRule ^(?:blog/)?stretching-is-essential/?$ /blog/best-low-impact-workouts-for-weight-loss/ [R=301,L]
  RewriteRule ^(?:blog/)?swap-challenge/?$ /blog/10-diet-myths-that-are-keeping-you-from-losing-weight/ [R=301,L]
  RewriteRule ^(?:blog/)?zinc-s-importance/?$ /blog/fueling-your-ferrari/ [R=301,L]
  RewriteRule ^(?:blog/)?cinnamon-coffee-smoothie/?$ /blog/healthy-homemade-granola/ [R=301,L]
  RewriteRule ^(?:blog/)?creamy-avocado-smoothie/?$ /blog/healthy-homemade-granola/ [R=301,L]
  RewriteRule ^(?:blog/)?healthy-breakfast-smoothies/?$ /blog/healthy-homemade-granola/ [R=301,L]
  RewriteRule ^(?:blog/)?italian-breakfast-panzanella/?$ /blog/five-different-frittatas/ [R=301,L]
  RewriteRule ^(?:blog/)?overnight-oat-parfaits/?$ /blog/healthy-homemade-granola/ [R=301,L]
  RewriteRule ^(?:blog/)?simple-vegan-breakfast-hash/?$ /blog/a-delicious-vegetarian-friendly-bowl/ [R=301,L]
  RewriteRule ^(?:blog/)?simply-delicious-pancakes/?$ /blog/a-hearty-and-healthy-breakfast-burrito/ [R=301,L]
  RewriteRule ^(?:blog/)?strawberry-banana-smoothie/?$ /blog/healthy-homemade-granola/ [R=301,L]
  RewriteRule ^(?:blog/)?super-duper-workout-juice/?$ /blog/fueling-your-ferrari/ [R=301,L]
  RewriteRule ^(?:blog/)?the-best-shakshuka/?$ /blog/five-different-frittatas/ [R=301,L]
  RewriteRule ^(?:blog/)?a-healthy-easy-meal-prep-guide-to-help-you-lose-weight/?$ /blog/fueling-your-ferrari/ [R=301,L]

  # SEO: 301-redirect old root-level blog URLs to their new /blog/ location (only when that page actually exists)
  RewriteCond %{REQUEST_URI} !^/blog/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/blog/$1/index.html -f
  RewriteRule ^([a-z0-9-]+)/?$ /blog/$1/ [R=301,L]

  # 1. Redirect /dist/foo to /foo (Remove /dist prefix if visible)
  RewriteCond %{THE_REQUEST} \s/dist/ [NC]
  RewriteRule ^dist/(.*)$ /$1 [R=301,L]

  # 2. Add trailing slash to directories (Prevent mod_dir exposing /dist)
  # If request doesn't end in slash, and it exists as a directory in /dist
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # 3. Serve root from dist/index.html
  RewriteRule ^$ dist/index.html [L]

  # 4. Rewrite everything else to /dist/ folder internally
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^(.*)$ /dist/$1 [L]
</IfModule>

# Serve the branded 404 page (built by Astro) instead of the hosting default
ErrorDocument 404 /dist/404.html

<IfModule mod_headers.c>
  # HSTS: tell browsers to always use HTTPS (site is fully HTTPS already)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Pages must always be served fresh. The hosting server's cache was
  # serving days-old copies of pages (blank forms, outdated content) even
  # after dashboard cache clears. no-cache means: always re-check with the
  # origin before serving. Static assets keep their long cache rules below.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set X-LiteSpeed-Cache-Control "no-cache"
  </FilesMatch>

  # Site stylesheets/scripts without content hashes (e.g. /styles/*.css): 7 days
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Astro's content-hashed assets (filename changes when content changes) can be cached forever
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images and icons: 30 days
  <FilesMatch "\.(webp|png|jpe?g|gif|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
