---
/**
 * Transform Personal Training - Personal Trainer Lakeview Page
 *
 * Neighborhood landing page for Lakeview, Chicago searches.
 * The faqs array renders both the visible FAQ and the FAQPage schema,
 * so the two can never drift apart.
 */

import Navigation from '../components/Navigation.astro';
import PopupForm from '../components/PopupForm.astro';
import Footer from '../components/Footer.astro';
import StyledGHLQuickLead from '../components/integration/StyledGHLQuickLead.astro';
import BaseHead from '../components/BaseHead.astro';

const pageTitle = "Personal Trainer in Lakeview, Chicago | Transform";
const pageDescription = "Private personal training at 2900 N Broadway in Lakeview. 1-on-1 30-minute sessions, nutrition coaching, daily support. Your first session is free.";

const faqs = [
  {
    q: "Where in Lakeview is Transform Personal Training located?",
    a: "We're at 2900 N Broadway St, Chicago, IL 60657, at the south end of Lakeview just steps from the Clark, Broadway and Diversey junction. The studio sits a couple of blocks north of the Lincoln Park border, so we're easy to reach from both neighborhoods."
  },
  {
    q: "Can I get to the studio without a car?",
    a: "Yes. The #36 Broadway and #22 Clark buses stop within about a block of the studio, the #76 Diversey stops two blocks south, and the Wellington and Belmont L stations are roughly a ten minute walk. Plenty of clients also bike over from the Lakefront Trail."
  },
  {
    q: "What are your hours?",
    a: "We open early and stay late on purpose: Monday through Thursday 5am to 9pm, Friday 5am to 8pm, and Saturday 7am to 3pm. Every session is by appointment, so you're never waiting on equipment."
  },
  {
    q: "How much does personal training cost in Lakeview?",
    a: "We publish our pricing instead of hiding it behind a sales call. Sessions are 30 minutes, which keeps the per-session cost manageable, and plans are tiered by how often you train. You can see the current tiers on our studio services page, and your first consultation is always free."
  },
  {
    q: "Do I need to be in shape before I start?",
    a: "No, and you wouldn't be the first to ask. Our founder started his own journey at 346 lbs, and this studio was built to be a supportive, non-judgmental place. Your program starts wherever you are today."
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{pageTitle}</title>
  <BaseHead title={pageTitle} description={pageDescription} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Personal Training",
    "name": "Personal Training in Lakeview, Chicago",
    "description": pageDescription,
    "url": "https://transformpersonaltraining.com/personal-trainer-lakeview/",
    "provider": {
      "@type": "HealthAndBeautyBusiness",
      "name": "Transform Personal Training",
      "@id": "https://transformpersonaltraining.com/#organization"
    },
    "areaServed": [
      { "@type": "Place", "name": "Lakeview" },
      { "@type": "Place", "name": "Lakeview East" },
      { "@type": "City", "name": "Chicago" }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://transformpersonaltraining.com/" },
      { "@type": "ListItem", "position": 2, "name": "Personal Trainer Lakeview", "item": "https://transformpersonaltraining.com/personal-trainer-lakeview/" }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />
  <meta name="description" content={pageDescription}>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">

  <!-- Design System Styles -->
  <link rel="stylesheet" href="/styles/design-tokens.css">
  <link rel="stylesheet" href="/styles/components.css">
</head>

<body>
  <!-- ===== NAVIGATION ===== -->
  <Navigation currentPath="/personal-trainer-lakeview" />
  <main>

  <!-- ===== HERO SECTION ===== -->
  <section class="lakeview-hero">
    <div class="lakeview-hero__content container">
      <span class="lakeview-hero__badge">Lakeview &middot; Chicago</span>
      <h1 class="lakeview-hero__title">PERSONAL TRAINER IN LAKEVIEW</h1>
      <p class="lakeview-hero__subtitle">
        A private 1-on-1 training studio at 2900 N Broadway, built for busy Lakeview
        professionals who want real results in 30 focused minutes.
      </p>
    </div>
  </section>

  <!-- ===== NEIGHBORHOOD SECTION ===== -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">A Private Studio in the Heart of Lakeview</h2>
      </div>
      <div class="neighborhood-copy">
        <p>
          Transform Personal Training has called Lakeview home since day one. You'll find us at
          <strong>2900 N Broadway St</strong>, steps from the Clark, Broadway and Diversey junction
          at the south end of the neighborhood. If you live or work anywhere between Belmont and
          the Lincoln Park border, we're the training studio around the corner, not a commute.
        </p>
        <p>
          This is a private studio, not a big-box gym. There's no crowd waiting for the squat rack,
          no sales floor, and nobody working out next to you. When you walk in, the space, the
          equipment and the coach are yours for 30 focused minutes. We open at 5am on weekdays so
          you can train before the Loop commute, and evening sessions run as late as 9pm.
        </p>
        <p>
          Getting here is easy without a car: the #36 Broadway and #22 Clark buses stop within a
          block, and the Wellington and Belmont L stops are about a ten minute walk. Driving?
          <a href="https://maps.google.com/?q=2900+N+Broadway+St+Chicago+IL+60657" rel="noopener noreferrer" target="_blank">Get directions</a>
          or reach out through our <a href="/contact/">contact page</a> and we'll point you to the easiest parking nearby.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== WHAT YOU GET ===== -->
  <section class="section" style="background-color: var(--color-black-50);">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">What Training Here Looks Like</h2>
        <p class="section-subtitle">
          Every part of the program is built around you, not a template.
        </p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2rem;">
        <div style="background: white; border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">🏋️</div>
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 600; color: var(--color-black-900); margin-bottom: 1rem;">30-Minute 1-on-1 Sessions</h3>
          <p style="color: var(--color-black-600); line-height: 1.7;">
            Private, efficient workouts personalized to your goals and fitness level. Long enough to
            work hard, short enough to fit a real Chicago schedule.
          </p>
        </div>
        <div style="background: white; border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">🍎</div>
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 600; color: var(--color-black-900); margin-bottom: 1rem;">Nutrition That Fits Your Life</h3>
          <p style="color: var(--color-black-600); line-height: 1.7;">
            Meal plans prescribed by your trainer around your goals and preferences, so progress
            continues between sessions, restaurant dinners included.
          </p>
        </div>
        <div style="background: white; border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">💬</div>
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 600; color: var(--color-black-900); margin-bottom: 1rem;">Daily Support</h3>
          <p style="color: var(--color-black-600); line-height: 1.7;">
            Check-ins and coaching from your own trainer every day, not just when you're in the
            studio. Accountability is the part most people are missing.
          </p>
        </div>
        <div style="background: white; border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
          <div style="font-size: 2rem; margin-bottom: 0.75rem;">🎯</div>
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 600; color: var(--color-black-900); margin-bottom: 1rem;">A Coach Matched to You</h3>
          <p style="color: var(--color-black-600); line-height: 1.7;">
            Weight loss, strength, joint-friendly training, pre/post-natal: we match you with the
            coach whose expertise and personality fit your goals.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TEAM SECTION ===== -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Your Lakeview Coaching Team</h2>
      </div>
      <div class="neighborhood-copy">
        <p>
          Founder David Bostik opened Transform after losing 150 lbs himself, and he built the
          studio he wished he'd had: supportive, private and free of judgment. The coaching team,
          Gerri, Miriam, Eric-Todd and Kristen, brings decades of combined experience across
          strength training, weight loss, corrective exercise, pre/post-natal fitness and
          accountability coaching. <a href="/meet-the-team/">Meet the whole team here</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS ===== -->
  <section class="section" style="background-color: var(--color-black-50);">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">What Clients Say</h2>
        <p class="section-subtitle">5-star rated by Chicago clients on Google and Yelp.</p>
      </div>
      <div class="lv-quotes">
        <blockquote class="lv-quote">
          <p>
            "Dave has a confident and seasoned grasp of all of the technical aspects of high-level
            training. To work with him is to experience intense focus. Plus, I grew some
            better-than-average guns."
          </p>
          <footer>&mdash; Arne W.</footer>
        </blockquote>
        <blockquote class="lv-quote">
          <p>
            "My trainer comes up with the craziest, toughest, but fun workouts I have ever done!
            He has become my mentor, and my friend, and I am so thankful I had the opportunity to
            change my life with him!"
          </p>
          <footer>&mdash; Sarah M.</footer>
        </blockquote>
      </div>
      <p style="text-align: center; margin-top: 2rem;">
        <a href="/success-stories/">Read more success stories &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ===== PRICING POINTER ===== -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Transparent Pricing, No Guesswork</h2>
      </div>
      <div class="neighborhood-copy">
        <p>
          We publish our session pricing right on the site, tiered by how often you train, so you
          know exactly what training costs before you ever talk to us. See the current plans on our
          <a href="/studio-services/">studio services page</a>, or read our honest breakdown of
          <a href="/blog/how-much-does-a-personal-trainer-cost-in-chicago/">what a personal trainer costs in Chicago</a>.
          Prefer to train from home? Our <a href="/online-training/">online coaching program</a>
          brings the same coaching to your phone. We also work with clients from
          <a href="/personal-trainer-lincoln-park/">Lincoln Park</a>, two blocks south of the studio.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section" style="background-color: var(--color-black-50);">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Lakeview Training FAQs</h2>
      </div>
      <div class="lv-faq">
        {faqs.map((f) => (
          <details class="lv-faq__item">
            <summary class="lv-faq__q">{f.q}</summary>
            <p class="lv-faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CONSULTATION FORM ===== -->
  <section id="consultation" style="position: relative; background-image: url('/images/form-background.webp'); background-size: cover; background-position: center; padding: 3rem 0;">
    <div style="position: absolute; inset: 0; background: rgba(15, 23, 42, 0.85);"></div>
    <div class="container" style="position: relative; z-index: 1;">
      <div style="max-width: 640px; margin: 0 auto; text-align: center;">
        <h2 style="font-family: var(--font-heading); font-size: 1.875rem; font-weight: 700; color: white; margin-bottom: 0.75rem;">
          Ready to Start? Your First Session Is Free
        </h2>
        <p style="color: rgba(255,255,255,0.9); margin-bottom: 2rem;">
          Tell us a little about your goals and we'll reach out right away to schedule your free
          consultation at the Lakeview studio.
        </p>
        <StyledGHLQuickLead />
      </div>
    </div>
  </section>

  </main>
  <Footer />

  <PopupForm />
</body>
</html>

<style>
  /* ===== HERO SECTION ===== */
  .lakeview-hero {
    background: linear-gradient(135deg, #0284c7 0%, #1e293b 100%);
    padding: var(--space-16) 0;
    position: relative;
    overflow: hidden;
  }

  .lakeview-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 60%;
    height: 200%;
    background: radial-gradient(ellipse, rgba(255,255,255,0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .lakeview-hero__content {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .lakeview-hero__badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    color: white;
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .lakeview-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 800;
    color: var(--color-accent-500);
    margin-bottom: 1.5rem;
    line-height: 1.1;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
  }

  .lakeview-hero__subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.95);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ===== BODY COPY ===== */
  .neighborhood-copy {
    max-width: 760px;
    margin: 0 auto;
  }

  .neighborhood-copy p {
    color: var(--color-black-700);
    line-height: 1.8;
    margin-bottom: 1.25rem;
  }

  /* ===== QUOTES ===== */
  .lv-quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .lv-quote {
    background: white;
    border-left: 4px solid var(--color-accent-500);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    margin: 0;
  }

  .lv-quote p {
    color: var(--color-black-700);
    line-height: 1.7;
    font-style: italic;
    margin-bottom: 1rem;
  }

  .lv-quote footer {
    color: var(--color-black-900);
    font-weight: 600;
  }

  /* ===== FAQ ===== */
  .lv-faq {
    max-width: 760px;
    margin: 0 auto;
  }

  .lv-faq__item {
    background: white;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }

  .lv-faq__q {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-black-900);
    cursor: pointer;
  }

  .lv-faq__a {
    color: var(--color-black-700);
    line-height: 1.7;
    margin-top: 0.75rem;
  }
</style>
