---
/**
 * Styled HighLevel Online Lead Form
 *
 * Embeds the "Online Lead Form - New Website" HighLevel form used only on
 * /online-training/. Styling of the form fields lives in HighLevel itself,
 * because the iframe is cross-origin and cannot be styled from this page.
 */

const formId = 'cvFDklrd12VYxhE8zwdF';
const formUrl = `https://api.leadconnectorhq.com/widget/form/${formId}`;
---

<div class="ghl-form-wrapper">
  <iframe
    src={formUrl}
    style="width:100%;height:100%;border:none;border-radius:3px"
    id={`inline-${formId}`}
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Online Lead Form - New Website"
    data-height="463"
    data-layout-iframe-id={`inline-${formId}`}
    data-form-id={formId}
    data-cookie-consent="true"
    data-cookie-consent-provider="auto"
    title="Online Lead Form - New Website"
  ></iframe>
</div>

<!-- HighLevel form embed script. is:inline keeps it a plain script tag,
     the official HighLevel embed method. Astro's module bundling of this
     script stopped working June 2026 and left forms rendering blank. -->
<script is:inline defer src="https://link.msgsndr.com/js/form_embed.js"></script>

<style>
  .ghl-form-wrapper {
    width: 100%;
    position: relative;
  }

  .ghl-form-wrapper iframe {
    width: 100%;
    border: none;
    border-radius: 0;
    min-height: 450px;
    background: transparent;
  }
</style>
