---
/**
 * BaseHead.astro
 *
 * Adds canonical + Open Graph + Twitter Card tags to a page <head>.
 * Purely additive: it does not render <title> or <meta name="description">
 * (each page already sets those), so it cannot create duplicates.
 *
 * Also loads the Google Analytics 4 tag (G-ZEZSZKQ9T7) on every page that uses it.
 *
 * Usage in a page <head>:
 *   <BaseHead title={pageTitle} description={pageDescription} />
 * For an article/blog post:
 *   <BaseHead title={...} description={...} image={image} type="article" />
 */
const SITE = 'https://transformpersonaltraining.com';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
}

const {
  title,
  description,
  image = '/images/hero-background.webp',
  type = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL(image, SITE).href;
---
<!-- Google tag (gtag.js) - Google Analytics 4 -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZEZSZKQ9T7"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-ZEZSZKQ9T7');
</script>

<link rel="canonical" href={canonical} />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content="Transform Personal Training" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
